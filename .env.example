# Django
DEBUG=False
SECRET_KEY=django-insecure-change-me-in-production-use-50-chars
DJANGO_SETTINGS_MODULE=config.settings.production
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://example.com
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_AGE=1209600
SECURE_HSTS_SECONDS=31536000
MAX_UPLOAD_SIZE_MB=5
ALLOWED_UPLOAD_EXTENSIONS=jpg,jpeg,png,pdf
ALLOWED_UPLOAD_MIME_TYPES=image/jpeg,image/png,application/pdf
RATE_LIMIT_LOGIN_LIMIT=5
RATE_LIMIT_LOGIN_WINDOW=300
RATE_LIMIT_REGISTER_LIMIT=5
RATE_LIMIT_REGISTER_WINDOW=600
RATE_LIMIT_2FA_LIMIT=5
RATE_LIMIT_2FA_WINDOW=300
RATE_LIMIT_CRITICAL_POST_LIMIT=20
RATE_LIMIT_CRITICAL_POST_WINDOW=60
OTP_TOTP_ISSUER=FinanceFlow
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=FinanceFlow <no-reply@example.com>
PASSWORD_RESET_TIMEOUT=259200

# Local development over http://localhost:
# SECURE_SSL_REDIRECT=False
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False

# Resend SMTP example:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=re_xxxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# DEFAULT_FROM_EMAIL=FinanceFlow <no-reply@your-verified-domain.com>

# HTTP / Gunicorn
HTTP_PORT=80
WEB_CONCURRENCY=3
WEB_TIMEOUT=60

# PostgreSQL used by Docker Compose
POSTGRES_DB=financeflow
POSTGRES_USER=financeflow
POSTGRES_PASSWORD=change-me

# Django database connection. In production Compose, Django connects through PgBouncer.
DATABASE_URL=
DB_HOST=pgbouncer
DB_PORT=6432
DB_NAME=financeflow
DB_USER=financeflow
DB_PASSWORD=change-me
DB_SSLMODE=prefer

# PgBouncer
PGBOUNCER_MAX_CLIENT_CONN=200
PGBOUNCER_DEFAULT_POOL_SIZE=20
PGBOUNCER_RESERVE_POOL_SIZE=5

# Redis remains dedicated to cache, locks and temporary results.
REDIS_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# RabbitMQ is the Celery broker in production Compose.
RABBITMQ_USER=financeflow
RABBITMQ_PASSWORD=change-me
CELERY_BROKER_URL=amqp://financeflow:change-me@rabbitmq:5672//
CELERY_TASK_DEFAULT_QUEUE=default

# Local development with an external database can still use DATABASE_URL instead
# of DB_HOST/DB_PORT, for example Supabase.
# DATABASE_URL=postgresql://USER:PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres?sslmode=require
